# Put real values in Render Environment, never in version control or chat.
ADMIN_PASSWORD=
HOST=127.0.0.1
PORT=4174
SITE_URL=https://your-store.example.com
DATA_DIR=/var/data
DURABLE_STORAGE_CONFIRMED=false

# Flutterwave Standard v3. Use TEST keys with test mode, live keys with live mode.
FLW_SECRET_KEY=
FLW_SECRET_HASH=
FLW_MODE=test
# Set true only after Flutterwave confirms international USD collection/settlement.
FLW_USD_APPROVED=false

CJ_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=VEGArance <orders@your-verified-domain.example.com>

# Optional address-based US taxes. Configure registered nexus in TaxJar first.
TAXJAR_API_TOKEN=
TAXJAR_SANDBOX=true
# Your actual US shipping origin, confirmed with CJ; never invent an address.
TAXJAR_ORIGIN_JSON=
