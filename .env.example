# Put real values in Render Environment, never in version control or chat.
ADMIN_PASSWORD=
HOST=127.0.0.1
PORT=4174
SITE_URL=https://your-store.example.com
DATA_DIR=/var/data
DURABLE_STORAGE_CONFIRMED=false

# Flutterwave Standard v3. Use TEST keys with test mode, live keys with live mode.
FLW_SECRET_KEY=
FLW_SECRET_HASH=
FLW_MODE=test
# Set true only after Flutterwave confirms international USD collection/settlement.
FLW_USD_APPROVED=false

CJ_API_KEY=
RESEND_API_KEY=

# AI copy (Groq default, OpenAI-compatible). No key = AI endpoints return 503.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.1-8b-instant

# Printful print-on-demand. OAuth private token, server-side only.
PRINTFUL_API_TOKEN=
# Optional: only for account-level tokens (multi-store). Leave blank otherwise.
PRINTFUL_STORE_ID=

# Printify print-on-demand. Personal Access Token (1-year validity — calendar
# rotation), server-side only. See PRINTIFY-SETUP.md.
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# Platform-level mailer for merchant email verification + password recovery.
# Without these, verification/recovery return 503 and merchant publishing is
# ungated (verification inactive). PLATFORM_PUBLIC_URL is the public base
# URL used in emailed verification/recovery links.
PLATFORM_RESEND_API_KEY=
PLATFORM_RESEND_FROM=
PLATFORM_PUBLIC_URL=https://your-store.example.com

# AliExpress Affiliate / Open Platform API. Approval-gated; all three values
# must come from the SAME AliExpress account. No keys = AliExpress endpoints
# return 503. See ALIEXPRESS-SETUP.md. Fulfilment stays manual.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
# Optional: ALIEXPRESS_BASE_URL (default https://api-sg.aliexpress.com/sync)
# Optional: ALIEXPRESS_SIGN_METHOD (md5 default, or hmac-sha256)
# Optional: ALIEXPRESS_CURRENCY (default USD), ALIEXPRESS_LANGUAGE (default EN)
EMAIL_FROM=VEGArance <orders@your-verified-domain.example.com>

# Optional address-based US taxes. Configure registered nexus in TaxJar first.
TAXJAR_API_TOKEN=
TAXJAR_SANDBOX=true
# Your actual US shipping origin, confirmed with CJ; never invent an address.
TAXJAR_ORIGIN_JSON=

# Platform credential encryption: 32 random bytes represented by 64 hex characters.
# Generate privately, retain securely, and configure the same value after redeploys.
PLATFORM_SECRET_KEY=

# Stripe buyer payments (Phase B: second provider slot, per-store selection).
# NOT CONFIGURED until these are set AND the merchant saves a Stripe
# connection for their store. Test keys start sk_test_, live keys sk_live_,
# webhook secret starts whsec_. See PAYMENTS.md. Live merchant payments are
# blocked globally until the platform enables them — test mode only for now.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MODE=test

# Merchant billing (Phase B: scaffolding only — no provider, no charges).
# BILLING_PROVIDER is documentation of the owner's decision: none | manual |
# stripe | flutterwave. 'none' (default) means no billing provider is
# connected and no merchant can be charged. See MERCHANT-BILLING.md.
BILLING_PROVIDER=none

# DATABASE_URL is RECOGNISED BUT NOT WIRED (Phase B). Setting it does NOT
# switch the database — the server still uses SQLite. The Postgres
# migration path is documented in STORAGE.md; do not set DATABASE_URL
# expecting Postgres until that migration lands.
# DATABASE_URL=
